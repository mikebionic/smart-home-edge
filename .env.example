# copy to .env and adjust, or just export these before running
DB_PATH=home.db
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b        # on a Raspberry Pi 5 use: gemma4:e2b
LOOKBACK_DAYS=14
MIN_DAYS=3

# Telegram push (optional but easy). Talk to @BotFather to get a token,
# then send your bot a message and read the chat id from:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
